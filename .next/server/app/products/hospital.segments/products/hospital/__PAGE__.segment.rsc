7:["$","section",null,{"className":"bg-white section-padding","children":["$","div",null,{"className":"max-w-3xl mx-auto px-5 sm:px-8 lg:px-10","children":[["$","$Lb",null,{"eyebrow":"FAQs","title":"Common questions about our Hospital Management System","className":"mb-12"}],["$","$L11",null,{"items":[{"question":"Can the system be customized for a private clinic vs a full hospital?","answer":"Yes. We configure the system to match your size and type. A small clinic needs fewer modules (outpatient, billing, pharmacy) while a full hospital requires inpatient, ward management, lab, radiology, and more."},{"question":"Does the system support insurance and NHIS billing?","answer":"Yes. The billing module supports cash, insurance, and NHIS claims processing with the ability to configure tariffs, deductibles, and coverage limits per scheme."},{"question":"Is patient data stored securely?","answer":"Yes. Patient data is encrypted at rest and in transit. Role-based access ensures only authorized staff can view specific patient information. We comply with data privacy best practices."},{"question":"Can doctors and staff access the system on mobile?","answer":"Yes. The system includes a mobile-responsive interface and optionally a dedicated mobile app for doctors to view patient notes, lab results, and schedules from any device."}]}]]}]}]
