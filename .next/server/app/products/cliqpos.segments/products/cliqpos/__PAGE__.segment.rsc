8:["$","section",null,{"className":"bg-white section-padding","children":["$","div",null,{"className":"max-w-3xl mx-auto px-5 sm:px-8 lg:px-10","children":[["$","$Lc",null,{"eyebrow":"FAQs","title":"Common questions about CliqPOS","className":"mb-12"}],["$","$L12",null,{"items":[{"question":"Does CliqPOS work without internet?","answer":"Yes. CliqPOS is built with offline-first architecture. Your team can continue selling even without internet and all transactions sync automatically when connectivity is restored."},{"question":"Can I manage multiple branches from one account?","answer":"Yes. The multi-branch module gives you a central dashboard to monitor all branches, view consolidated reports, manage staff, and transfer stock between locations."},{"question":"Does CliqPOS support barcode scanning and receipt printing?","answer":"Yes. CliqPOS is compatible with USB and Bluetooth barcode scanners and thermal receipt printers. We help you set up your hardware during onboarding."},{"question":"Can I customize CliqPOS for my specific business type?","answer":"Yes. CliqPOS supports multiple business profiles. Restaurants get table management and kitchen display features; pharmacies get prescription tracking; retailers get category-based product management."},{"question":"What reports does CliqPOS generate?","answer":"CliqPOS generates daily sales summaries, product performance reports, inventory movement reports, staff sales reports, customer purchase history, and financial profit/loss reports."}]}]]}]}]
