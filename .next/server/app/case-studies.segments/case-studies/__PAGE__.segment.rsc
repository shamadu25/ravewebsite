4:["$","$L3","hospital-system",{"title":"Hospital Management System","industry":"Healthcare","tag":"Software","problem":"A hospital was handling patient records, billing, and pharmacy using manual registers, leading to errors and slow service.","result":"Faster patient service, accurate billing, better record keeping, and improved operational efficiency.","impact":"Faster patient service","href":"/case-studies/hospital-system","index":4}]
5:["$","$L3","school-system",{"title":"School Management System","industry":"Education","tag":"Software","problem":"A school was managing admissions, fees, attendance, and results with paper registers and spreadsheets.","result":"Streamlined school administration, faster fee collection, easier results management, and better parent communication.","impact":"Streamlined admin","href":"/case-studies/school-system","index":5}]
6:["$","$L3","splendy-mart",{"title":"Splendy Mart — Multi-Branch POS & Retail Management","industry":"Retail & Supermarkets","tag":"Software","problem":"Splendy Mart, a growing supermarket with branches across Accra and Tema, was struggling with inaccurate stock tracking, slow checkout queues, theft, and zero visibility across branches. Sales were recorded manually, stock counts drifted daily, and managers had no real-time data to act on.","result":"Faster checkout at every register, significant reduction in stock discrepancies and theft incidents, and full real-time visibility across all Accra and Tema branches from a single management dashboard.","impact":"Faster checkout & zero stock gaps","href":"/case-studies/splendy-mart","index":6}]
7:["$","$L3","mobile-doctors",{"title":"Mobile Doctors Ltd — Pharmacy Management System","industry":"Healthcare & Pharmacy","tag":"Software","problem":"Mobile Doctors Ltd in Spintex, Accra was managing pharmacy inventory and sales manually, leading to stock errors, missed expiry tracking, slow counter service, and no reliable reporting for the pharmacy manager.","result":"Smooth, efficient daily pharmacy operations with accurate stock tracking, faster patient service at the counter, and elimination of manual reconciliation errors.","impact":"Smooth & accurate pharmacy operations","href":"/case-studies/mobile-doctors","index":7}]
