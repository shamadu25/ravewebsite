21:["$","section",null,{"className":"bg-white section-padding","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","$L1c",null,{"eyebrow":"FAQs","title":"Common questions about POS and ERP systems","className":"mb-12"}],["$","$L2d",null,{"items":[{"question":"Is CliqPOS a custom build or an existing product?","answer":"CliqPOS is an existing RaveSoft product that we actively develop and deploy. It can be used as-is or customized for your specific business operations. We also build fully custom ERP systems for complex enterprise needs."},{"question":"Does the system work offline?","answer":"Yes. Our POS systems are built with offline capability — your team can continue selling even without internet, and all data syncs automatically when connectivity is restored."},{"question":"Can I manage multiple branches from one dashboard?","answer":"Yes. Our multi-branch module lets you manage all locations, view consolidated reports, transfer stock between branches, and control access per branch from a central admin dashboard."},{"question":"Can the ERP be integrated with our existing accounting software?","answer":"Yes. We integrate with QuickBooks, Sage, Xero, and custom accounting platforms through API connections or data export modules."}]}]]}]}]
