21:["$","section",null,{"className":"bg-white section-padding","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","$L1c",null,{"eyebrow":"FAQs","title":"Common questions about business automation","className":"mb-12"}],["$","$L2a",null,{"items":[{"question":"What kind of business processes can you automate?","answer":"We automate data entry, approval workflows, report generation, notifications and alerts, email campaigns, payment reminders, employee onboarding, inventory reorder triggers, customer follow-ups, and much more."},{"question":"Do I need to replace my existing tools?","answer":"Not necessarily. We build automations that connect your existing tools — your CRM, accounting software, forms, spreadsheets, email, WhatsApp, and others — through integrations and custom logic."},{"question":"How much time can automation save my team?","answer":"Our clients typically report saving 10–30+ hours per week across their teams after implementing workflow automation. The exact savings depend on your current processes."},{"question":"Is automation only for large businesses?","answer":"No. Small and medium businesses benefit greatly from automation, especially for sales follow-ups, invoicing, customer communications, and reporting. The cost is often recovered within the first month."}]}]]}]}]
