# SMTP email configuration (contact form)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=

# Google Analytics 4 — get your ID from analytics.google.com
# Looks like: G-XXXXXXXXXX. Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# RaveSoft AI Agent — Next.js API routes + Prisma/MySQL (single project, no separate backend)
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_AGENT_ENABLED=true
AI_ASSISTANT_NAME="Ama"

# Admin CRM dashboard (/admin) — single admin login, no public signup.
# Generate ADMIN_SESSION_SECRET with: openssl rand -base64 32
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public URL used in notification email links (e.g. https://ravesoftsolutions.com)
NEXT_PUBLIC_APP_URL=https://ravesoftsolutions.com

# Where hot-lead / human-handoff notification emails go. Falls back to
# CONTACT_EMAIL if not set. Uses the same SMTP settings as the contact form.
LEAD_NOTIFICATION_EMAIL=

# Paid-social funnel analytics (/ai-employee) — each is a no-op until set.
# Meta Pixel ID from Meta Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity project ID.
NEXT_PUBLIC_CLARITY_ID=

# Calendly booking webhook (/book-consultation → /api/webhooks/calendly)
# Signing key returned when the webhook subscription is created via Calendly's API.
# Without it, the endpoint rejects all requests rather than skip verification.
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── RaveSoft AI Operating System (/admin) ───────────────────────────────
# Protects /api/os/cron. The GitHub Actions workflow (.github/workflows/os-cron.yml) sends it as a Bearer token; add it as a repo secret too, plus APP_URL. openssl rand -base64 32
CRON_SECRET=
# HMAC secret for signed payment events -> POST /api/os/webhooks/payment (header x-rave-signature = hex HMAC-SHA256 of the raw body)
PAYMENTS_WEBHOOK_SECRET=
# Optional: second model provider / model routing by task tier (fast | standard | strong)
ANTHROPIC_API_KEY=
OS_LLM_PROVIDER=
# Optional: prospect discovery (Google Places API New)
GOOGLE_PLACES_API_KEY=
# Optional: "From" address for outbound email (defaults to SMTP_USER)
SMTP_FROM=

# ── AI OS: product feed, channels, integrations (all optional; each shows NOT CONNECTED until set) ──
# Signed lifecycle events from CliqPOS/KOVABOT/HMS/Restovax -> POST /api/os/webhooks/product (x-rave-signature = hex HMAC-SHA256 of raw body)
PRODUCT_WEBHOOK_SECRET=
# WhatsApp Cloud API: sending + inbound replies (webhook: /api/os/webhooks/whatsapp)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Slack incoming webhook; GitHub issues/PRs (GITHUB_REPO=owner/name)
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=

# Display name shown in the admin header for the env-based admin login
ADMIN_NAME=

# ── Email (outbound SMTP is configured above; inbound uses IMAP, read-only) ──
# Replies are read from this mailbox. Defaults to the SMTP host/login, which is usually the same mailbox.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Address replies go to (defaults to SMTP_FROM / SMTP_USER)
REPLY_TO=
# Max automated emails per day while the mailbox warms up (default 40)
OS_EMAIL_DAILY_CAP=40
# Signs one-click unsubscribe links (defaults to ADMIN_SESSION_SECRET)
OS_UNSUBSCRIBE_SECRET=

# ── Payments (Paystack) ──
# Secret key from Paystack → Settings → API Keys & Webhooks. Server-side only. Also add the webhook URL shown in Admin → Integrations.
PAYSTACK_SECRET_KEY=
# Currency Paystack charges in. Your Paystack account must have it enabled (USD for global, GHS for Ghana, NGN for Nigeria...).
PAYSTACK_CURRENCY=USD
# Multiply USD prices by this to get the charge currency (1 for USD; the live USD→GHS rate if PAYSTACK_CURRENCY=GHS)
PAYSTACK_FX_RATE=1

# ── Google Gemini (optional second/third model provider) ──
GEMINI_API_KEY=
# Route a tier to a provider first (openai | google | anthropic). Unset = OpenAI first, others as fallback.
# After comparing in Admin → Model lab, a common choice is: OS_PROVIDER_FAST=google
OS_PROVIDER_FAST=
OS_PROVIDER_STANDARD=
OS_PROVIDER_STRONG=
# Override model IDs when Google releases newer ones
OS_GEMINI_MODEL_FAST=
OS_GEMINI_MODEL_STANDARD=
OS_GEMINI_MODEL_STRONG=
